---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

export interface Props {
  title?: string;
  description?: string;
  starsLabel: string;
  // Site-relative canonical path ("/", "/docs", "/docs/build", …).
  // Rendered as an absolute self-referencing canonical via Astro.site.
  canonical?: string;
  // Open Graph type: "website" for the landing, "article" for /docs pages.
  ogType?: string;
}
const {
  title = "LAN Messenger — Free, Open-Source Local Network Messaging",
  description = "LAN Messenger is a free, open-source instant messaging app for Windows, macOS and Linux. Chat and transfer files over your local network without a central server or internet connection.",
  starsLabel,
  canonical,
  ogType = "website",
} = Astro.props;
const canonicalUrl =
  canonical && Astro.site ? new URL(canonical, Astro.site).href : null;
// 128px logo: fine for messengers and twitter summary card, below the
// 1200x630 recommendation for large link previews (no bigger asset yet).
const ogImageUrl = Astro.site
  ? new URL("/images/logo.png", Astro.site).href
  : null;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <title>{title}</title>
  {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={ogType} />
  {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
  {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <link rel="icon" href="/favicon.ico" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&amp;family=JetBrains+Mono:wght@400;500;600&amp;display=swap"
  />
</head>
<body>
  <Header starsLabel={starsLabel} />
  <main id="top">
    <slot />
  </main>
  <Footer />
</body>
</html>
