---
import { type DialogLine } from "../data/mockup-dialog";
export interface Props {  peerName: string;
  peerTime: string;
  peerAvatar: string;
  dialog: DialogLine[];
}
const { peerName, peerTime, peerAvatar, dialog } = Astro.props;
const U = "images/lmc-ui";
---

<div class="cw" role="img" aria-label={`LAN Messenger chat with ${peerName}`}>
  <div class="cw-log">
    {dialog.map((line, i) => {
      const start = i === 0 || dialog[i - 1].from !== line.from;
      if (line.from === "bob") {
        return start ? (
          <div class="msg in" data-author="bob">
            <img src={peerAvatar} alt="" width="28" height="28" />
            <div class="col">
              <div class="head"><span class="name">{peerName}</span><span class="time">{peerTime}</span></div>
              <div class="bubble">{line.text}</div>
            </div>
          </div>
        ) : (
          <div class="msg in-next" data-author="bob"><div class="bubble">{line.text}</div></div>
        );
      }
      return start ? (
        <div class="msg out" data-author="alice">
          <div class="head"><span class="you">You</span><span class="time">{peerTime}</span></div>
          <div class="bubble">{line.text}</div>
        </div>
      ) : (
        <div class="msg out-next" data-author="alice"><div class="bubble">{line.text}</div></div>
      );
    })}
  </div>
  <div class="cw-split" aria-hidden="true"><img src={`${U}/vgrip.png`} alt="" width="54" height="7" /></div>
  <div class="cw-divt" aria-hidden="true"></div>
  <div class="cw-tools" aria-hidden="true">
    <img style="left:5px" src={`${U}/font.png`} alt="" width="16" height="16" />
    <img style="left:28px" src={`${U}/fontcolor.png`} alt="" width="16" height="16" />
    <i style="left:50px"></i>
    <img style="left:57px" src={`${U}/smiley.png`} alt="" width="16" height="16" />
    <i style="left:79px"></i>
    <img style="left:86px" src={`${U}/file.png`} alt="" width="16" height="16" />
    <img style="left:109px" src={`${U}/sendfolder.png`} alt="" width="16" height="16" />
    <i style="left:131px"></i>
    <img style="left:138px" src={`${U}/save.png`} alt="" width="16" height="16" />
    <img style="left:280px" src={`${U}/transfer.png`} alt="" width="16" height="16" />
    <img style="left:303px" src={`${U}/history.png`} alt="" width="16" height="16" />
  </div>
  <div class="cw-divb" aria-hidden="true"></div>
  <div class="cw-input" aria-hidden="true"><span class="cw-typed"></span></div>
</div>

<style>
  /* --- Pixel-perfect 325x360 clone, isolated from global.css --- */
  .cw,
  .cw *,
  .cw *::before,
  .cw *::after {
    box-sizing: border-box;
  }
  .cw {
    width: 325px;
    height: 360px;
    flex: none;
    display: flex;
    flex-direction: column;
    background: #fff;
    color: #000;
    font-family: "Segoe UI", Tahoma, Verdana, sans-serif;
    font-size: 12px;
    line-height: 1;
    text-align: left;
    overflow: hidden;
    user-select: none;
  }
  .cw img { display: block; }

  .cw-log {
    flex: none;
    height: 291px;
    border: 1px solid #7a7a7a;
    background: #f4f5f7;
    overflow-y: auto;
    padding: 8px;
    transition: opacity 0.3s;
  }
  .cw-log.is-switching { opacity: 0; }
  .msg.demo-in { animation: cw-in 0.25s ease-out; }
  @keyframes cw-in { from { opacity: 0; transform: translateY(4px); } }
  .msg { margin-top: 8px; }
  .msg:first-child { margin-top: 0; }
  .msg.in-next, .msg.out-next { margin-top: 2px; }
  .in { display: flex; gap: 8px; }
  .in img {
    flex: none;
    width: 28px;
    height: 28px;
    border-radius: 50%;
  }
  .in .col { flex: 1; min-width: 0; }
  .head {
    font-size: 12px;
    line-height: 1.35;
    margin-bottom: 2px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .in .name { font-weight: 600; color: #1e293b; }
  .head .time { color: #64748b; }
  .in .head .time { margin-left: 6px; }
  .out .head { text-align: right; color: #64748b; }
  .out .head .you { margin-right: 6px; }
  .bubble {
    font-size: 12px;
    line-height: 1.4;
    padding: 10px 12px;
    max-width: 84%;
    width: fit-content;
    overflow-wrap: break-word;
  }
  .in .bubble {
    background: linear-gradient(#ffffff, #f8f9fa);
    border: 1px solid #e2e8f0;
    border-radius: 12px 12px 12px 2px;
    color: #1e293b;
  }
  .in-next .bubble {
    margin-left: 36px;
    background: linear-gradient(#ffffff, #f8f9fa);
    border: 1px solid #e2e8f0;
    border-radius: 2px 12px 12px 2px;
    color: #1e293b;
  }
  .out { display: flex; flex-direction: column; align-items: flex-end; }
  .out .bubble {
    background: linear-gradient(#2563eb, #1d4ed8);
    border-radius: 12px 12px 2px 12px;
    color: #fff;
  }
  .out-next { display: flex; flex-direction: column; align-items: flex-end; }
  .out-next .bubble {
    background: linear-gradient(#2563eb, #1d4ed8);
    border-radius: 12px 2px 2px 12px;
    color: #fff;
  }

  /* Splitter: log bottom y290, grip y291-297 (vgrip 54x7, x135) */
  .cw-split {
    flex: none;
    height: 7px;
    background: #f0f0f0;
    position: relative;
  }
  .cw-split img {
    position: absolute;
    left: 135px;
    top: 0;
    width: 54px;
    height: 7px;
  }

  /* Top divider: y298, h1 */
  .cw-divt {
    flex: none;
    height: 1px;
    background: #fff;
  }

  /* Toolbar: y299-322, h24, 16x16 icons (y303), 1x14 separators (y304) */
  .cw-tools {
    flex: none;
    height: 24px;
    background: #f0f0f0;
    position: relative;
  }
  .cw-tools img {
    position: absolute;
    top: 4px;
    width: 16px;
    height: 16px;
  }
  .cw-tools i {
    position: absolute;
    top: 5px;
    width: 1px;
    height: 14px;
    background: #d3d3d3;
  }

  /* Bottom divider: y323, h1 */
  .cw-divb {
    flex: none;
    height: 1px;
    background: #a0a0a0;
  }

  /* Input field: y324-359, h36 */
  .cw-input {
    flex: none;
    height: 36px;
    background: #fff;
  }
  /* Demo typing target: empty span is zero-size, layout unchanged */
  .cw-typed {
    display: block;
    padding: 4px 6px;
    white-space: nowrap;
  }
  /* Blinking caret while the demo types */
  .cw-typed.is-typing::after {
    content: "";
    display: inline-block;
    width: 1px;
    height: 12px;
    margin-left: 1px;
    vertical-align: -2px;
    background: #000;
    animation: cw-blink 1s steps(1) infinite;
  }
  @keyframes cw-blink { 50% { opacity: 0; } }
</style>
