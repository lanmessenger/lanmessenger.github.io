---
import OsWindowFrame from "./OsWindowFrame.astro";
import AppMainWindow from "./AppMainWindow.astro";
import AppChatWindow from "./AppChatWindow.astro";
import {
  AUTHORS,
  DIALOG_TIME,
  START_AT,
  type DialogLine,
} from "../data/mockup-dialog";
import { CONTACTS } from "../data/mockup-contacts";

export interface Props {
  dialog: DialogLine[];
}
const { dialog } = Astro.props;
---

<div class="hero-mockups">
  <OsWindowFrame title="LAN Messenger" width="265px">
    <AppMainWindow
      userName="Alice"
      userStatus="Available"
      note="Type a note"
      myAvatar="images/lmc-ui/avatar-cat.png"
      myStatusIcon="images/lmc-ui/online.png"
      groups={[
        {
          name: "General",
          contacts: CONTACTS,
        },
      ]}
    />
  </OsWindowFrame>
  <div class="hero-chat" id="hero-chat-demo"
    data-dialog={JSON.stringify(dialog)}
    data-start-at={START_AT}
    data-authors={JSON.stringify(AUTHORS)}>
    <OsWindowFrame title="Bob - Conversation" width="325px">
      <AppChatWindow
        senderName={AUTHORS.bob.name}
        senderTime={DIALOG_TIME}
        senderAvatar={AUTHORS.bob.avatar}
        aliceName={AUTHORS.alice.name}
        aliceAvatar={AUTHORS.alice.avatar}
        dialog={dialog.slice(0, START_AT)}
      />
    </OsWindowFrame>
  </div>
</div>

<style>
  /* Mockup row: top margin from trust badges, gap between windows */
  .hero-mockups {
    margin-top: 3rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: flex-start;
    gap: 8rem;
  }
  /* Chat window sits slightly lower than the main one */
  .hero-chat {
    margin-top: 4rem;
  }
  /* Narrow screens: windows stack vertically, tighten the spacing */
  @media (max-width: 767px) {
    .hero-mockups { gap: 2rem; }
    .hero-chat { margin-top: 0; }
  }
</style>

<script>
/* Chat demo loader: the animation is decorative, so the player loads
   only when the browser is idle — page load never waits for it.
   With prefers-reduced-motion the chunk is not fetched at all. */
(function () {
  var root = document.getElementById("hero-chat-demo");
  if (!root) return;
  if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
  function boot() {
    import("../scripts/mockup-demo.ts").then(function (m) {
      m.playDemo(
        JSON.parse(root.dataset.dialog || "[]"),
        Number(root.dataset.startAt || "1"),
        JSON.parse(root.dataset.authors || "{}"),
      );
    });
  }
  if ("requestIdleCallback" in window) {
    (window as Window & { requestIdleCallback: (cb: () => void) => void }).requestIdleCallback(boot);
  } else {
    setTimeout(boot, 1);
  }
})();
</script>
