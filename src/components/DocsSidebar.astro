---
// Classic docs table of contents: page list on the left, h2 anchors of the
// current page nested underneath it. Presentational only — the page builds
// `pages` in an explicit order and passes the current page's h2 headings.
export interface DocsNavPage {
  href: string;
  title: string;
}
export interface DocsNavHeading {
  slug: string;
  text: string;
}
export interface Props {
  pages: DocsNavPage[];
  currentHref: string;
  headings: DocsNavHeading[];
}
const { pages, currentHref, headings } = Astro.props;
---
<nav class="docs-nav" aria-label="Documentation">
  <ul>
    {pages.map((page) => (
      <li>
        <a
          href={page.href}
          aria-current={page.href === currentHref ? "page" : undefined}
        >
          {page.title}
        </a>
        {page.href === currentHref && headings.length > 0 && (
          <ul>
            {headings.map((h) => (
              <li>
                <a href={`${currentHref}#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ul>
        )}
      </li>
    ))}
  </ul>
</nav>

<style>
  .docs-nav {
    font-size: 14px;
  }
  .docs-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.125rem;
  }
  .docs-nav > ul > li > ul {
    margin: 0.125rem 0 0.375rem 0.75rem;
    padding-left: 0.75rem;
    border-left: 1px solid var(--border);
  }
  .docs-nav a {
    display: block;
    padding: 0.375rem 0.75rem;
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--muted);
    line-height: 1.4;
  }
  .docs-nav a:hover {
    color: var(--ink);
    background: var(--surface-low);
  }
  .docs-nav a[aria-current="page"] {
    color: var(--primary);
    font-weight: 600;
    background: var(--surface-low);
  }
  .docs-nav > ul > li > ul a {
    font-size: 13px;
    padding: 0.25rem 0.625rem;
  }

  /* Wide screens: stick below the fixed 4rem site header. The nav is a
     grid item, so align-self keeps it at its own height for sticky. */
  @media (min-width: 1024px) {
    .docs-nav {
      position: sticky;
      top: calc(4rem + 1.5rem);
      align-self: start;
    }
  }

  /* Narrow screens: the sidebar becomes a plain block above the article. */
  @media (max-width: 1023px) {    .docs-nav {
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      background: var(--card);
      padding: 1rem 1.25rem;
    }
    .docs-nav > ul {
      display: flex;
      flex-wrap: wrap;
      gap: 0.25rem 0.5rem;
    }
    .docs-nav > ul > li > ul {
      display: none;
    }
  }
</style>
