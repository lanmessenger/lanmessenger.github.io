---
import Icon from "./Icon.astro";
import Mockup from "./Mockup.astro";
import { SITE } from "../data/site";
import { buildDialog } from "../data/mockup-dialog";
import type { HeroTargets } from "../data/downloads";

export interface Props {
  starsLabel: string;
  version: string;
  targets: HeroTargets;
}
const { starsLabel, version: V, targets } = Astro.props;
const dialog = buildDialog(V);
---
<section class="hero" aria-labelledby="hero-title">
  <div class="wrap">
    <div class="status-pill">
      <span class="dot" aria-hidden="true"></span>
      <span>Open Source &amp; LAN-first</span>
      <span class="ver">v{V}</span>
    </div>

    <h1 id="hero-title">An open-source LAN messenger for <span class="accent">instant</span>, local-first team communication</h1>
    <p class="lede">Free and open-source instant messaging application for Windows, Mac, and Linux. Works seamlessly through your local network without internet or servers — secure, private, and lightning fast.</p>

    <div class="hero-cta">
      <span class="hero-dl-wrap hero-single" id="hero-split-group">
        <span class="hero-split-row">
          <a
            class="btn btn-primary hero-split-main"
            id="hero-download-btn"
            href={targets.windows.href}
            data-targets={JSON.stringify(targets)}
          >
            <Icon name="download" />
            <span id="hero-download-text">Download for Windows</span>
            <span class="os-tag" id="hero-os-tag">v{V} .exe</span>
          </a>
          <button
            class="hero-split-toggle"
            id="hero-dropdown-toggle"
            type="button"
            aria-haspopup="menu"
            aria-expanded="false"
            aria-controls="hero-dropdown-menu"
            aria-label="Choose another package"
            hidden
          >
            <Icon name="chevron" />
          </button>
        </span>
        <a
          class="hero-dl-cap"
          id="hero-mac-cap"
          href="/docs/install-macos"
          hidden
        >Mac blocked the first launch? One-command fix</a>
        <div
          class="hero-dropdown"
          id="hero-dropdown-menu"
          role="menu"
          hidden
        >
          <div class="hero-dropdown-head">
            <span id="hero-dropdown-title">Linux Packages</span>
            <span class="hero-dropdown-ver">v{V}</span>
          </div>
          <div data-group="linux">
            {targets.linuxAlternatives.map((alt) => (
              <a class="hero-dropdown-item" role="menuitem" href={alt.href}>
                <span class="hero-dropdown-text">
                  <b>{alt.title}</b>
                  <small>{alt.sub}</small>
                </span>
                <span class="hero-dropdown-size">{alt.size}</span>
              </a>
            ))}
          </div>
          <div data-group="mac" hidden>
            {targets.macAlternatives.map((alt) => (
              <a class="hero-dropdown-item" role="menuitem" href={alt.href}>
                <span class="hero-dropdown-text">
                  <b>{alt.title}</b>
                  <small>{alt.sub}</small>
                </span>
                <span class="hero-dropdown-size">{alt.size}</span>
              </a>
            ))}
          </div>
        </div>
      </span>
      <a class="btn btn-secondary" href={SITE.repo} target="_blank" rel="noreferrer">
        <Icon name="terminal" />
        <span>View on GitHub</span>
        <span class="star-tag">{starsLabel}</span>
      </a>
    </div>

    <ul class="trust-badges">
      <li><Icon name="shieldcheck" /><span>No Server Required</span></li>
      <li><Icon name="lock" /><span>AES-256 &amp; RSA Encryption</span></li>
      <li><Icon name="wifioff" /><span>Works 100% Offline</span></li>
      <li><Icon name="monitor" /><span>Cross-Platform (Win / Mac / Linux)</span></li>
    </ul>

    <Mockup dialog={dialog} />
  </div>
</section>

<style>
  /* Anchor for the Mac caption strictly above the download button.
     Absolute: never shifts buttons or badges. */
  .hero-dl-wrap {
    position: relative;
    display: flex;
  }
  .hero-dl-cap {
    position: absolute;
    bottom: calc(100%);
    left: 0;
    right: 0;
    text-align: center;
    font-size: 12px;
    color: var(--warn-ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .hero-dl-cap:hover {
    text-decoration: none;
  }
  .hero-dl-cap[hidden] {
    display: none;
  }

  /* Split button: shared primary pill; toggle/menu unhidden by JS on Linux/Mac. */
  .hero-split-row {
    display: flex;
    flex: 1 1 auto;
    min-width: 0;
  }
  .hero-split-main {
    flex: 1 1 auto;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
  }
  /* Single button (default, incl. no-JS): full rounding. */
  .hero-single .hero-split-main {
    border-top-right-radius: var(--radius);
    border-bottom-right-radius: var(--radius);
  }
  .hero-split-toggle {
    display: inline-flex;
    align-items: center;
    padding: 0 0.75rem;
    border: 1px solid transparent;
    border-left-color: rgba(255, 255, 255, 0.25);
    border-radius: 0 var(--radius) var(--radius) 0;
    background: var(--primary);
    color: #fff;
    cursor: pointer;
    transition: background 0.2s;
  }
  .hero-split-toggle:hover {
    background: var(--primary-hover);
  }
  /* svg is rendered by the child Icon component: :global() keeps the match. */
  .hero-split-toggle :global(svg) {
    width: 18px;
    height: 18px;
    transition: transform 0.2s;
  }
  .hero-split-toggle[aria-expanded="true"] :global(svg) {
    transform: rotate(180deg);
  }
  .hero-split-toggle[hidden] {
    display: none;
  }

  .hero-dropdown {
    position: absolute;
    top: calc(100% + 0.5rem);
    left: 0;
    width: 20rem;
    max-width: min(20rem, 90vw);
    padding: 0.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--card);
    box-shadow: var(--shadow-xl);
    z-index: 30;
    text-align: left;
  }
  .hero-dropdown[hidden] {
    display: none;
  }
  @media (min-width: 640px) {
    .hero-dropdown {
      left: auto;
      right: 0;
    }
  }
  .hero-dropdown-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.375rem 0.75rem;
    margin-bottom: 0.25rem;
    border-bottom: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--faint);
  }
  .hero-dropdown-ver {
    color: var(--emerald-dark);
    font-weight: 600;
  }
  .hero-dropdown-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.625rem 0.75rem;
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--ink);
  }
  .hero-dropdown-item:hover {
    background: var(--surface-low);
  }
  .hero-dropdown-text {
    display: grid;
    gap: 0.125rem;
    min-width: 0;
  }
  .hero-dropdown-text b {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 600;
  }
  .hero-dropdown-text small {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--muted);
  }
  .hero-dropdown-size {
    flex: none;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--muted);
    background: var(--surface-container);
    border-radius: 4px;
    padding: 0.125rem 0.5rem;
    white-space: nowrap;
  }
  .hero-dropdown-item:first-of-type .hero-dropdown-size {
    color: var(--primary);
    background: var(--primary-soft);
  }
</style>

<script is:inline>
/* Hero download button: per-OS targets come from data-targets (build-time API).
   Linux/Mac also get a split dropdown; Windows stays single. */
(function () {
  "use strict";

  function detect() {
    var ua = (navigator.userAgent || "").toLowerCase();
    var platform = (navigator.platform || "").toLowerCase();
    if (ua.indexOf("mac") !== -1 || platform.indexOf("mac") !== -1) return "mac";
    if (ua.indexOf("linux") !== -1 || platform.indexOf("linux") !== -1) return "linux";
    return "windows";
  }

  function setMenu(menu, group) {
    if (!menu) return;
    var blocks = menu.querySelectorAll("[data-group]");
    for (var i = 0; i < blocks.length; i++) {
      blocks[i].hidden = blocks[i].getAttribute("data-group") !== group;
    }
  }

  function closeMenu(toggle, menu) {
    if (!menu || menu.hidden) return;
    menu.hidden = true;
    if (toggle) toggle.setAttribute("aria-expanded", "false");
  }

  function init() {
    var btn = document.getElementById("hero-download-btn");
    var label = document.getElementById("hero-download-text");
    var tag = document.getElementById("hero-os-tag");
    var cap = document.getElementById("hero-mac-cap");
    var group = document.getElementById("hero-split-group");
    var toggle = document.getElementById("hero-dropdown-toggle");
    var menu = document.getElementById("hero-dropdown-menu");
    var title = document.getElementById("hero-dropdown-title");
    if (!btn || !label || !tag) return;
    var raw = btn.getAttribute("data-targets");
    if (!raw) return;
    var set;
    try {
      set = JSON.parse(raw);
    } catch (e) {
      return;
    }
    var os = detect();
    var target = set[os] || set.windows;
    if (!target || !target.href) return;
    btn.setAttribute("href", target.href);
    label.textContent = target.text;
    tag.textContent = target.tag;
    // Mac-only caption above the download button.
    if (cap) cap.hidden = !set.mac || target !== set.mac;

    // Split dropdown: Linux/Mac only.
    if (!toggle || !menu || !group) return;
    if (os !== "linux" && os !== "mac") return;
    group.classList.remove("hero-single");
    toggle.hidden = false;
    setMenu(menu, os);
    if (title) title.textContent = os === "linux" ? "Linux Packages" : "macOS Packages";

    toggle.addEventListener("click", function (e) {
      e.stopPropagation();
      var willOpen = menu.hidden;
      menu.hidden = !willOpen;
      toggle.setAttribute("aria-expanded", willOpen ? "true" : "false");
    });

    document.addEventListener("click", function (e) {
      if (!group.contains(e.target)) closeMenu(toggle, menu);
    });
    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape") {
        if (menu.hidden) return;
        closeMenu(toggle, menu);
        if (group.contains(document.activeElement)) toggle.focus();
      }
    });
    group.addEventListener("focusout", function (e) {
      if (!group.contains(e.relatedTarget)) closeMenu(toggle, menu);
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }
})();
</script>
