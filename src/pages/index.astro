---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Download from "../components/Download.astro";
import Features from "../components/Features.astro";
import Screenshots from "../components/Screenshots.astro";
import Support from "../components/Support.astro";
import { getRepoMeta, getLatestReleaseInfo, formatStars } from "../lib/github";
import { SITE, releaseTagFor } from "../data/site";
import { buildReleaseView } from "../data/downloads";

// Build-time data: stars + latest release assets resolve once during `astro build`.
// No fallbacks — if the API is unreachable, the build fails.
// SITE_VERSION env pins an older tag `v<version>` for local debugging.
const [{ stars }, releaseInfo] = await Promise.all([
  getRepoMeta(),
  getLatestReleaseInfo(),
]);
const starsLabel = `${formatStars(stars)} stars`;
const release = buildReleaseView(releaseInfo);
// Minimal SoftwareApplication schema: identity + platforms + license + price.
// Kept factual (no ratings, no invented screenshots).
const softwareJsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "LAN Messenger",
  applicationCategory: "CommunicationApplication",
  operatingSystem: ["Windows", "macOS", "Linux"],
  softwareVersion: release.version,
  url: "https://lanmessenger.github.io/",
  license: SITE.licenseUrl,
  sameAs: [SITE.repo],
  isAccessibleForFree: true,
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
};
---
<BaseLayout starsLabel={starsLabel} canonical="/">
  <script type="application/ld+json" set:html={JSON.stringify(softwareJsonLd)} />
  <Hero
    starsLabel={starsLabel}
    version={release.version}
    targets={release.heroTargets}
  />
  <Download version={release.version} releaseTag={releaseTagFor(release.version)} entries={release.downloads} />
  <Features />
  <Screenshots />
  <Support version={release.version} />
</BaseLayout>
